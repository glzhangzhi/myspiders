cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

.vscode
history.json

session_name.session
*.session

# Claude 账户用量运行时快照（由 app/services/claude_usage.py 写入）
app/data/claude_usage.json

# Taiga 同步的任务数据（运行时数据，原地保留但不纳入版本控制）

# poller 运行配置(含 token),改用 client/config.yaml.example 作模板
client/config.yaml
app/data/backup_status.json

# Claude Code 本地工具状态(项目/个人设置 + worktree 隔离目录),不纳入版本控制
.claude/

# 本地log文件
logs
# 迁移到 Windows 后留存的运维备份（unit 文件 / 旧 token 日志）
archive/

# .env 的历史备份。上面那条 `.env` 只挡得住本体，`.env.bak-20260921-223254`
# 这种带时间戳的副本照样会被 git 看见 —— 而它们装着同样的真实凭证。
.env.bak*
.env.*.bak

# 私钥 / 证书一律不进仓库。公钥也挡掉：它本身不敏感，
# 但属于个人凭证件，没有放进代码库的理由。
*.pem
*.key
*.p12
*.pfx

# Windows 侧小工具的编译产物（源码在 scripts/win/ 下，.exe 不纳入版本控制）
*.exe

# 杂物暂存区：从别处倒腾来的待整理文件（Apps Script、csv 等），不是本项目代码
graveyard*/

# story 采集的滴答清单快照（运行时数据，见 settings.story_archive_dir）
/data/

# 前端构建产物与依赖（由 scripts/deploy.sh 现场构建）
app/dashboard/dist/
web/node_modules/
!web/src/lib/
