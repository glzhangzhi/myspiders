# MySpiders 环境变量模板 / environment template
# 复制为 .env 并填入真实值 / copy to .env and fill in:  cp .env.example .env
# 变量名 = 配置字段名（大小写不敏感）。核心字段见 app/core/settings.py，
# 各功能的字段见 app/features/<id>/settings.py —— 没写在这里的都有可用的默认值。

# ── 核心 / core ──
ADMIN_TOKEN=                    # 管理接口令牌（请求头 x-token）/ admin token for write APIs
MONGO_URI=mongodb://localhost:27017
MONGO_DEFAULT_DB=spider_data
LOG_DIR=logs
LOG_FILENAME=spider_system.log
DEFAULT_TIMEZONE=Europe/Berlin
PUBLIC_BASE_URL=                # 面板公网地址，通知里的跳转链接用 / public URL for notification links
BACKGROUND_TASKS_ENABLED=true   # false = 只提供 API 与页面（开发实例）/ API-only dev instance

# ── ntfy 推送 / push notifications ──
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC_PREFIX=myspiders_    # 完整 topic = 前缀 + 功能名 / full topic = prefix + name

# ── DeepSeek（菜谱转换 / AI 小镇 / LLM 计费）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Nintendo eShop ──
URL=                            # 港服 eShop 折扣数据源 / HK eShop discount feed URL

# ── Joybuy 降价监控 / price watch ──
JOYBUY_COOKIE=                  # 登录态 cookie（至少含 mfs_session）
JOYBUY_SKU=
JOYBUY_PRICE_THRESHOLD=

# ── 菜谱推 Kindle / recipes → Kindle (KOReader SSH) ──
KINDLE_HOST=
KINDLE_SSH_KEY=
KINDLE_SSH_JUMP=                # 可选：ssh 跳板别名 / optional ssh jump host alias

# ── 酒馆资料 / SillyTavern ──
TAVERN_DATA_DIR=/root/sillytavern/data
TAVERN_USER=default-user

# ── LLM 用量归类 / LLM usage project categories (JSON) ──
# [["工作", {"projects": ["repo-a"], "machines": ["work-pc"]}], ...]
LLM_PROJECT_CATEGORIES=

# ── 媒体下载 / media download agent ──
MEDIA_AGENT_HOST=               # 执行下载的机器（ssh 别名）/ ssh alias of the download host
